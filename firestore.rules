rules_version = '2';
// Valor Frontier player IDs and developer gifts.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid == 'RDRWH8Vm6qMgjWJgQm89G5NoIVZ2'; }

    // usernames/{lowercase name} -> { uid, name, mail }. Claimed once. mail is the hidden login
    // address used for password logins; the owner may add it later to a username made before accounts.
    match /usernames/{key} {
      allow get: if signedIn();
      allow list, delete: if isAdmin();
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && !('mail' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mail'])
        && request.resource.data.mail is string && request.resource.data.mail.size() <= 120;
      allow create: if signedIn()
        && key.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'mail'])
        && (!('mail' in request.resource.data) || (request.resource.data.mail is string && request.resource.data.mail.size() <= 120))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.lower() == key
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.name == request.resource.data.name;
    }

    // players/{uid} -> { name, created, seen }. One username per player.
    match /players/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, delete: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'created', 'seen'])
        && request.resource.data.name is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.name.lower())).data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
    }

    // requests/{id} -> { uid, name, items, note, status, created }. Players ask; only the developer answers.
    match /requests/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'items', 'note', 'status', 'created'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.name
        && request.resource.data.status == 'open'
        && request.resource.data.items is map
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.created == request.time;
      allow update, delete: if isAdmin();
    }

    // feedback/{id} -> { uid, name, topic, text, created }. Players write; only the developer reads.
    match /feedback/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'topic', 'text', 'created'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.name
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 60
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.created == request.time;
    }

    // saves/{uid} -> { progress, settings, ts }. Each player's backed-up save; only they can read or write it.
    match /saves/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['progress', 'settings', 'ts'])
        && request.resource.data.progress is map
        && request.resource.data.settings is map
        && request.resource.data.ts is number;
    }

    // gifts/{id} -> { uid, name, items, note, claimed, created }. Only the developer sends them.
    match /gifts/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.claimed == false
        && request.resource.data.claimed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedAt']));
    }

    // rooms/{5 digit code} -> { host, hostName, offer, created, answer, guest, guestName }. Co-op: swaps connection details once.
    // The host creates it, one guest answers it once, and the host deletes it when they connect. Anyone may clear a room older than an hour.
    match /rooms/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('^[0-9]{5}$')
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'offer', 'created'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 20
        && request.resource.data.offer is string && request.resource.data.offer.size() <= 20000
        && request.resource.data.created == request.time;
      allow update: if signedIn() && !('answer' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'guest', 'guestName'])
        && request.resource.data.guest == request.auth.uid
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 20000
        && request.resource.data.guestName is string && request.resource.data.guestName.size() <= 20;
      allow delete: if signedIn() && (resource.data.host == request.auth.uid || isAdmin()
        || request.time > resource.data.created + duration.value(1, 'h'));
    }
  }
}
